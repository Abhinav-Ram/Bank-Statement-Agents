# Copy to .env (git-ignored). Model names + endpoints live here; no code changes to swap models.

# --- Chat LLM: GroqCloud (OpenAI-compatible) ---
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
# Create a key at https://console.groq.com/keys and paste it here:
LLM_API_KEY='paste-your-groq-api-key-here'
# Must match an id from GET /models (scripts/check_llm.py lists them).
CHAT_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0
# Extra request fields as JSON (provider-specific). Qwen3: "none" = thinking off.
# gpt-oss models: {"reasoning_effort": "low"} (low|medium|high).
LLM_EXTRA_BODY={"reasoning_effort": "none"}
# Groq free tier counts max_tokens against ~1000 output tokens/min: keep it below 1000.
LLM_MAX_TOKENS=900

# --- Embeddings (Phase 3): Groq has no embeddings API; choose a provider then. ---
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# Local alternative (oMLX on this Mac) - uncomment to switch back:
# LLM_PROVIDER=omlx
# LLM_BASE_URL=http://localhost:8000/v1      # docker: http://host.docker.internal:8000/v1
# LLM_API_KEY='your-omlx-key'
# CHAT_MODEL=gemma-4-E2B-it-oQ4e-mtp
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

DATABASE_URL=postgresql://bank:bank@localhost:5433/bank_agents
